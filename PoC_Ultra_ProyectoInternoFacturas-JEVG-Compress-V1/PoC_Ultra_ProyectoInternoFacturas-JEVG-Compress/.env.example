APP_NAME=Invoice Portal PoC
# development | test | production
APP_ENV=development
# Solo eleva el nivel de log a DEBUG; nunca expone trazas al usuario.
DEBUG=false
# Obligatoria, minimo 32 caracteres. scripts/create_env.py la genera al crear .env.
# Para generarla a mano: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# PostgreSQL local en Docker (compose.yaml). Compose lee estas variables del mismo .env.
POSTGRES_USER=portal
POSTGRES_DB=portal
# Puerto del host, solo en 127.0.0.1 (el 5432 y el 5433 suelen estar ocupados).
POSTGRES_PORT=55432
# scripts/create_env.py genera la contrasena y arma DATABASE_URL con ella.
POSTGRES_PASSWORD=
# Obligatoria; solo se admite postgresql+psycopg://usuario:contrasena@127.0.0.1:puerto/base
DATABASE_URL=
# Keycloak, proveedor de identidad (IdP) del portal. Local: servicio "keycloak" de compose.yaml.
# Puerto del host, solo en 127.0.0.1.
KEYCLOAK_PORT=58080
# Obligatorias. scripts/create_env.py escribe las del entorno local. En produccion, https:// obligatorio.
KEYCLOAK_SERVER_URL=
KEYCLOAK_REALM=
# Cliente OIDC del portal (inicio de sesion) y cuenta de servicio (alta de usuarios).
KEYCLOAK_CLIENT_ID=portal-facturas-web
KEYCLOAK_ADMIN_CLIENT_ID=portal-facturas-admin
# Obligatorias, minimo 32 caracteres. scripts/create_env.py las genera; compose.yaml las entrega a Keycloak.
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_CLIENT_SECRET=
# Segundos de espera de cada llamada a Keycloak (1 a 60).
KEYCLOAK_TIMEOUT=10
# Administrador inicial de la consola de Keycloak local (http://127.0.0.1:58080/admin). create_env.py genera la
# contrasena.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=
# Contrasena de las cuentas demo @poc.local en development; la usa scripts/seed_db.py. create_env.py la genera.
DEMO_PASSWORD=
# Las rutas relativas se resuelven contra la raiz del proyecto, no contra el directorio de trabajo.
STORAGE_PATH=./storage
LOG_DIR=./logs
MAX_UPLOAD_MB=20
# Sin definir: false en development y true en test/production (cookie Secure; requiere HTTPS).
# SESSION_HTTPS_ONLY=true
# Zona horaria de las reglas de calendario (corte del dia 20) y del ano del folio.
BUSINESS_TIMEZONE=America/Mexico_City
# Numero de respaldos que conserva scripts/backup.py.
BACKUP_RETENTION=14
BACKUP_DIR=./backups
# Correo (HU-08). Sin definir MAIL_BACKEND: smtp en production y file en los demas entornos.
# file no envia: escribe cada correo como .eml en MAIL_OUTBOX_DIR (prohibido en production).
# Para conectar un servidor real, vea README.md, "Conectar el servidor SMTP".
# MAIL_BACKEND=file
# Obligatoria con smtp. Ejemplo: Portal de Proveedores ULTRASIST <no-reply@ultrasist.com.mx>
MAIL_FROM=
MAIL_OUTBOX_DIR=./outbox
# Obligatoria con smtp.
SMTP_HOST=
SMTP_PORT=587
# starttls | ssl | none (none esta prohibido en production)
SMTP_SECURITY=starttls
# Opcionales: si hay usuario, el transporte inicia sesion.
SMTP_USERNAME=
SMTP_PASSWORD=
# Segundos de espera del servidor SMTP (1 a 120).
SMTP_TIMEOUT=10
AI_ENABLED=false
DOCUMENT_AI_PROVIDER=mock
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_CONTENT_UNDERSTANDING_ENDPOINT=
AZURE_CONTENT_UNDERSTANDING_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=
