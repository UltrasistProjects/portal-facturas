# Keycloak de preproduccion (compose.yaml de este directorio). Copie a .env en el servidor y complete los valores;
# .env no se versiona. Genere cada secreto con: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Nombre DNS publico del servidor, sin https://. Sin dominio propio sirve sslip.io: kc.<IP con guiones>.sslip.io
# (por ejemplo kc.129-146-10-20.sslip.io) resuelve a esa IP. Los puertos 80 y 443 deben estar abiertos.
KEYCLOAK_HOSTNAME=
# Contrasena de la PostgreSQL propia de Keycloak.
KC_DB_PASSWORD=
# Administrador inicial de la consola (https://KEYCLOAK_HOSTNAME/admin).
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=
# Secretos de los clientes del realm: los mismos valores van en KEYCLOAK_CLIENT_SECRET y KEYCLOAK_ADMIN_CLIENT_SECRET del
# portal en Vercel. Minimo 32 caracteres.
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_CLIENT_SECRET=
# URL publica del portal en Vercel (https://...): configure-realm.sh registra su callback y su cierre de sesion.
PORTAL_URL=
# Correo de Keycloak (restablecimiento de contrasena): el mismo servidor y remitente SMTP del portal.
KEYCLOAK_SMTP_HOST=
KEYCLOAK_SMTP_PORT=587
KEYCLOAK_SMTP_FROM=
KEYCLOAK_SMTP_SECURITY=starttls
KEYCLOAK_SMTP_USER=
KEYCLOAK_SMTP_PASSWORD=
